# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp

# npm lockfile (pnpm is the workspace manager)
package-lock.json
.pnp.js

# testing
/coverage

# next.js
.next/
/out/

# typescript build output
dist/

# production
/build

# misc
.DS_Store
.env*
!.env.example
.vscode

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# runtime data (per-app)
apps/**/.data/

# runtime generated media (uploaded via Micropub)
media/

# planning artifacts
.planning
.planning/
