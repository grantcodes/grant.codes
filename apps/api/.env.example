# Backend-specific environment variables for local development
# Copy this file to apps/api/.env.local and fill in the values.
# The root .env (at the repo root) provides shared/public vars.
# These vars are loaded by the `dev` script via --env-file=.env.local

# Micropub/Postr authentication
MICROPUB_TOKEN=your-micropub-token
TOKEN_SECRET=your-token-secret
MICROPUB_ENDPOINT_PASSWORD_SERVER=your-db-password

# Optional: Telegram syndication
# TELEGRAM_CHANNEL=
# TELEGRAM_TOKEN=

# Optional: Instagram syndication
# INSTAGRAM_USERNAME=
# INSTAGRAM_PASSWORD=
# INSTAGRAM_PROXY=

# Optional: CouchDB replication (for production sync)
# COUCH_DB_PUBLIC_ADMIN=
# COUCH_DB_PRIVATE_ADMIN=

# Optional: PubSubHubbub hub
# HUB=

# Optional: Deploy webhook URL — POST /api/deploy-webhook triggers this URL
# after publishing content. Auth is via MICROPUB_TOKEN (Bearer token).
# DEPLOY_WEBHOOK_URL=https://hooks.example.com/deploy
