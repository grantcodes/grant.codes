---
// Wide page layout — maps and summaries, or edge to edge with `full`
import Layout from './Layout.astro'
import Container from '../components/shell/Container.astro'

export interface Props {
  title?: string
  description?: string
  canonicalUrl?: string
  noindex?: boolean
  full?: boolean
}

const { title, description, canonicalUrl, noindex, full = false } = Astro.props
---

<Layout title={title} description={description} canonicalUrl={canonicalUrl} noindex={noindex}>
  <Container size={full ? 'full' : 'wide'}>
    <slot />
  </Container>
</Layout>
