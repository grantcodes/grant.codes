---
// Default page layout — full shell with standard width container
import Layout from './Layout.astro'
import Container from '../components/shell/Container.astro'

export interface Props {
  title?: string
  description?: string
  canonicalUrl?: string
  noindex?: boolean
}

const { title, description, canonicalUrl, noindex } = Astro.props
---

<Layout title={title} description={description} canonicalUrl={canonicalUrl} noindex={noindex}>
  <Container>
    <slot />
  </Container>
</Layout>
