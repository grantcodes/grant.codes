---
import UpdatesTimeline from '../../../components/UpdatesTimeline.astro'
import { getUpdates, UPDATES_PER_PAGE } from '../../../lib/updates'

const page = Number(Astro.params.page)
const pages = Math.ceil((await getUpdates()).length / UPDATES_PER_PAGE)
if (!Number.isInteger(page) || page < 2 || page > pages) return new Response(null, { status: 404 })
---

<UpdatesTimeline page={page} />
