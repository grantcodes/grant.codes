---
// New Post — Micropub composer landing page
//
// Status: STEADY-STATE PLACEHOLDER — Micropub composer is part of the
// postrchild browser extension and does not need an Astro-side rebuild.
// This page is the valid target route for the extension's compose flow.
//
// Original Next.js behavior:
// - Static page with Post component rendering a new-post template
// - Used with the postrchild browser extension for Micropub drafting
// - ArticleLayout, robots: noindex
//
// Astro approach (static mode):
// - Static page providing the landing route the extension expects
// - The composer itself lives in the postrchild extension, not in the site

import ArticleLayout from '../../layouts/ArticleLayout.astro'
const siteUrl = import.meta.env.NEXT_PUBLIC_URL ?? 'https://grant.codes'
---

<ArticleLayout title="New Post" canonicalUrl={`${siteUrl}/new`} noindex={true}>
  <h2 class="page-title">New Post</h2>

  <div class="card card--glass" style="padding: 1.5rem;">
    <p style="margin-top: 0;">
      This page is used with the postrchild browser extension to compose and publish
      new posts via the <a href="https://micropub.spec.indieweb.org/">Micropub</a> API.
    </p>

    <p>The Micropub composer lives in the postrchild browser extension.
    This page provides the stable route that the extension targets for its
    compose-and-publish workflow.</p>

    <hr style="border: none; border-top: 1px solid var(--g-color-border-default); margin: 1.5rem 0;" />

    <p style="font-size: 0.8rem; opacity: 0.6; margin-bottom: 0;">
      The postrchild extension uses this page to provide a template for drafting
      new articles directly on grant.codes.
    </p>
  </div>
</ArticleLayout>
