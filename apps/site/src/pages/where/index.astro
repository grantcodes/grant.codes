---
// Where am I? — static fallback page
//
// Status: STATIC FALLBACK — live location tracking deferred
// Cutover-blocker: NO — advanced location/map behavior is can-slip.
//
// Original behavior (apps/web):
// - Client component WhereLocation calls /api/last-location (Dawarich proxy)
// - Renders live location info + Leaflet map
// - FullWidthLayout, robots: noindex
//
// Astro approach (static mode):
// - Static page with Grant's base location (Dundee, Scotland)
// - Embedded OSM iframe for simple map visual
// - No live location API call
//
// Upgrade path: re-implement as a Lit web component with client-side
// location fetching and a shared <grantcodes-map> or Lit map component.

import FullWidthLayout from '../../layouts/FullWidthLayout.astro'

const authorName = import.meta.env.NEXT_PUBLIC_AUTHOR_NAME ?? 'Grant Richmond'
const siteUrl = import.meta.env.NEXT_PUBLIC_URL ?? 'https://grant.codes'

// Dundee, Scotland coordinates
const latitude = 56.462
const longitude = -2.9707
---

<FullWidthLayout title="Where am I?" canonicalUrl={`${siteUrl}/where`}>
  <div style="max-width: 50rem;">
    <h2 class="page-title">Where am I?</h2>

    <div class="card card--glass" style="padding: 1.5rem; margin-bottom: 1.5rem;">
      <p style="margin-top: 0;">{authorName} is based in <strong>Dundee, Scotland</strong>.</p>
      <p>This page shows a static fallback. Live location tracking (Dawarich integration with map) is available as a post-cutover enhancement.</p>
    </div>

    <!-- Static map embed (OSM) -->
    <div style="width: 100%; border-radius: 0.4rem; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.15);">
      <iframe
        title="Map of Dundee, Scotland"
        src={`https://www.openstreetmap.org/export/embed.html?bbox=${longitude - 0.1}%2C${latitude - 0.05}%2C${longitude + 0.1}%2C${latitude + 0.05}&layer=mapnik&marker=${latitude}%2C${longitude}`}
        style="width: 100%; height: 400px; border: none; display: block;"
        loading="lazy"
        referrerpolicy="no-referrer"
      ></iframe>
    </div>
    <div style="font-size: 0.7rem; opacity: 0.5; text-align: right; margin-top: 0.3rem;">
      <a href={`https://www.openstreetmap.org/?mlat=${latitude}&mlon=${longitude}`} target="_blank" rel="noopener noreferrer">
        View on OpenStreetMap
      </a>
    </div>
  </div>
</FullWidthLayout>
