---
// Where am I? — static fallback with progressive live enhancement
//
// Status: STATIC FALLBACK with progressive enhancement
// - Static page shows Grant's base location (Dundee, Scotland) with OSM embed
// - Client JS fetches GET /api/last-location from apps/api
// - Updates location text and map coordinates when live data is available
//
// Legacy behavior (Next.js):
// - Client component WhereLocation called /api/last-location (Dawarich proxy)
// - Rendered live location info + Leaflet map
// - FullWidthLayout, robots: noindex

import FullWidthLayout from '../../layouts/FullWidthLayout.astro'
import { GrantCodesCard } from '@grantcodes/ui/components/card/index.js'

const authorName = import.meta.env.NEXT_PUBLIC_AUTHOR_NAME ?? 'Grant Richmond'
const siteUrl = import.meta.env.NEXT_PUBLIC_URL ?? 'https://grant.codes'
const apiUrl = import.meta.env.NEXT_PUBLIC_API_URL ?? 'https://backend.grant.codes'

// Dundee, Scotland coordinates (base/fallback)
const latitude = 56.462
const longitude = -2.9707
---

<FullWidthLayout title="Where am I?" canonicalUrl={`${siteUrl}/where`} noindex={true}>
  <div style="max-width: 50rem;">
    <h2 class="page-title">Where am I?</h2>

    <GrantCodesCard>
      <p id="where-location-status">
        {authorName} is based in <strong>Dundee, Scotland</strong>.
      </p>
    </GrantCodesCard>

    <!-- Map embed (OSM) — coordinates updated dynamically when live data available -->
    <div class="embed-wrap">
      <iframe
        id="where-map-frame"
        title="Map of Dundee, Scotland"
        src={`https://www.openstreetmap.org/export/embed.html?bbox=${longitude - 0.1}%2C${latitude - 0.05}%2C${longitude + 0.1}%2C${latitude + 0.05}&layer=mapnik&marker=${latitude}%2C${longitude}`}
        style="width: 100%; height: 400px; border: none; display: block;"
        loading="lazy"
        referrerpolicy="no-referrer"
      ></iframe>
    </div>
    <div class="text-muted" style="text-align: right; margin-top: 0.3rem; opacity: 0.5;">
      <a id="where-map-link" href={`https://www.openstreetmap.org/?mlat=${latitude}&mlon=${longitude}`} target="_blank" rel="noopener noreferrer">
        View on OpenStreetMap
      </a>
    </div>
  </div>
</FullWidthLayout>

<script define:vars={{ apiUrl }} is:inline>
  (function () {
    var statusEl = document.getElementById('where-location-status')
    var mapFrame = document.getElementById('where-map-frame')
    var mapLink = document.getElementById('where-map-link')

    if (!statusEl || !mapFrame || !mapLink) return

    fetch(apiUrl + '/api/last-location')
      .then(function (res) { return res.json() })
      .then(function (data) {
        if (!data || !data.location) return
        var loc = data.location
        if (!loc || !loc.latitude || !loc.longitude) return

        var lat = parseFloat(loc.latitude)
        var lng = parseFloat(loc.longitude)
        if (isNaN(lat) || isNaN(lng)) return

        // Update location text
        var place = loc.geodata && loc.geodata.properties ? loc.geodata.properties.name : ''
        var regionParts = []
        if (loc.city) regionParts.push(loc.city)
        if (loc.country) regionParts.push(loc.country)
        var region = regionParts.join(', ')
        var label = place || region || lat.toFixed(4) + ', ' + lng.toFixed(4)
        statusEl.textContent = 'Currently near ' + label + '.'

        // Update map iframe
        mapFrame.src = 'https://www.openstreetmap.org/export/embed.html?bbox=' +
          (lng - 0.1) + '%2C' + (lat - 0.05) + '%2C' +
          (lng + 0.1) + '%2C' + (lat + 0.05) +
          '&layer=mapnik&marker=' + lat + '%2C' + lng

        // Update map link
        mapLink.href = 'https://www.openstreetmap.org/?mlat=' + lat + '&mlon=' + lng
      })
      .catch(function () {
        // Keep static fallback — no change needed
      })
  })()
</script>
