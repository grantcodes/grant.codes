---
// Contact page
// Ported from the legacy Next.js app/(default)/contact/page.tsx

import BaseLayout from '../layouts/BaseLayout.astro'
import { GrantCodesCard } from '@grantcodes/ui/components/card/index.js'
import { GrantCodesIcon } from '@grantcodes/ui/components/icon/index.js'
import { Mail } from '@grantcodes/ui/icons'

const authorEmail = import.meta.env.NEXT_PUBLIC_AUTHOR_EMAIL ?? ''
const siteUrl = import.meta.env.NEXT_PUBLIC_URL ?? 'https://grant.codes'
---

<BaseLayout title="Contact" canonicalUrl={`${siteUrl}/contact`}>
  <h1 class="page-title">Get in touch!</h1>

  <GrantCodesCard>
    {authorEmail && (
      <ul class="list-plain">
        <li>
          <a href={`mailto:${authorEmail}`} class="contact-link">
            <grantcodes-icon style="font-size: 2em" set:html={Mail}></grantcodes-icon>
            Email
          </a>
        </li>
      </ul>
    )}
  </GrantCodesCard>
</BaseLayout>

<style>
  .contact-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    font-size: 1.4rem;
    font-weight: bold;
  }

  .contact-link:hover {
    text-decoration: underline wavy;
  }

</style>
