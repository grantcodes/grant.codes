---
// Contact page
// Ported from the legacy Next.js app/(default)/contact/page.tsx

import { site } from '../lib/site'
import BaseLayout from '../layouts/BaseLayout.astro'
import { GrantCodesCard } from '@grantcodes/ui/components/card/index.js'
import { Camera, Code, Mail } from 'lucide-static'

const siteUrl = site.url
const links = [
  { text: 'Email', href: `mailto:${site.author.email}`, icon: Mail },
  { text: 'Instagram', href: site.author.instagram, icon: Camera },
  { text: 'Github', href: site.author.github, icon: Code },
]
---

<BaseLayout title="Contact" canonicalUrl={`${siteUrl}/contact`}>
  <h1 class="page-title">Get in touch!</h1>

  <GrantCodesCard>
    <ul class="list-plain">
      {links.map((link) => (
        <li>
          <a href={link.href} class="contact-link" rel="me">
            <grantcodes-icon style="font-size: 2em" set:html={link.icon}></grantcodes-icon>
            {link.text}
          </a>
        </li>
      ))}
    </ul>
  </GrantCodesCard>
</BaseLayout>

<style>
  .contact-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    font-size: 1.4rem;
    font-weight: bold;
  }

  .contact-link:hover {
    text-decoration: underline wavy;
  }

</style>
