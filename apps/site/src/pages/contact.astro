---
// Contact page
// Ported from apps/web/app/(default)/contact/page.tsx

import BaseLayout from '../layouts/BaseLayout.astro'

const authorEmail = import.meta.env.NEXT_PUBLIC_AUTHOR_EMAIL ?? ''
const siteUrl = import.meta.env.NEXT_PUBLIC_URL ?? 'https://grant.codes'
---

<BaseLayout title="Contact" canonicalUrl={`${siteUrl}/contact`}>
  <h1 class="page-title">Get in touch!</h1>

  <div class="card">
    {authorEmail && (
      <ul class="contact-list">
        <li>
          <a href={`mailto:${authorEmail}`} class="contact-link">
            <svg class="contact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="4" width="20" height="16" rx="2" />
              <path d="M22 4L12 13L2 4" />
            </svg>
            Email
          </a>
        </li>
      </ul>
    )}
  </div>
</BaseLayout>

<style>
  .contact-list {
    list-style: none;
    display: block;
    padding: 0;
    margin: 0;
  }

  .contact-list > li {
    display: block;
  }

  .contact-list > li + li {
    margin-top: 0.5rem;
  }

  .contact-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    font-size: 1.4rem;
    font-weight: bold;
  }

  .contact-link:hover {
    text-decoration: underline wavy;
  }

  .contact-icon {
    width: 2em;
    height: 2em;
    flex-shrink: 0;
  }
</style>
