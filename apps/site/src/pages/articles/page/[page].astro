---
// Articles archive pagination — /articles/page/2, /articles/page/3, etc.

import { site } from '../../../lib/site'
import { getArchivePosts } from '../../../lib/archive'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import Post from '../../../components/Post.astro'
import { GrantCodesCard } from '@grantcodes/ui/components/card/index.js'
import { GrantCodesPagination } from '@grantcodes/ui/components/pagination/index.js'

const { page } = Astro.params
const pageNum = Number(page)

const siteUrl =
  site.url

const articles = (await getArchivePosts()).filter((post) => post.postType === 'article')

const PER_PAGE = 25
const totalPages = Math.max(Math.ceil(articles.length / PER_PAGE), 1)
if (!Number.isInteger(pageNum) || pageNum < 2 || pageNum > totalPages) {
  return new Response(null, { status: 404 })
}
const startIndex = (pageNum - 1) * PER_PAGE
const pageArticles = articles.slice(startIndex, startIndex + PER_PAGE)

const pageTitle = `Articles page ${pageNum}`
const canonicalUrl = `${siteUrl}/articles/page/${pageNum}`
const baseUrl = '/articles'
const prevPage = pageNum > 1 ? pageNum - 1 : null
const nextPage = pageNum < totalPages ? pageNum + 1 : null
const prevHref = prevPage === 1 ? baseUrl : prevPage ? `${baseUrl}/page/${prevPage}` : ''
const nextHref = nextPage ? `${baseUrl}/page/${nextPage}` : ''
---

<BaseLayout title={pageTitle} canonicalUrl={canonicalUrl}>
  <h2 class="page-title">{pageTitle}</h2>

  {pageArticles.length === 0 && (
    <GrantCodesCard>
      <p>No articles found on page {pageNum}.</p>
    </GrantCodesCard>
  )}

  {pageArticles.length > 0 && (
    <>
      <div class="post-list">
        {pageArticles.map((post) => (
          <Post post={post} compact />
        ))}
      </div>

      <GrantCodesPagination
        previousHref={prevHref}
        nextHref={nextHref}
        page={pageNum}
        pages={totalPages}
      />
    </>
  )}
</BaseLayout>
