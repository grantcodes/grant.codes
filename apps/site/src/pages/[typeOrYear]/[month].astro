---
// Monthly summary — /2024/3
import { site } from '../../lib/site'
import FullWidthLayout from '../../layouts/FullWidthLayout.astro'
import ArchiveSummary from '../../components/ArchiveSummary.astro'
import { getArchiveMonths, getListedPosts, getMonthTrack, inMonth, monthNames, trackDistanceKm } from '../../lib/archive'

const year = Number(Astro.params.typeOrYear)
const month = Number(Astro.params.month)
const months = await getArchiveMonths()
const index = months.findIndex(([y, m]) => y === year && m === month)
if (index === -1) return new Response(null, { status: 404 })
const previous = months[index - 1]
const next = months[index + 1]

const link = (target?: [number, number]) =>
  target && { href: `/${target[0]}/${target[1]}`, label: `${monthNames[target[1] - 1].slice(0, 3)} ${target[0]}` }

const posts = (await getListedPosts()).filter((post) => inMonth(post, year, month))
const track = await getMonthTrack(year, month)
const fullTrack = await getMonthTrack(year, month, Infinity)
const title = `${monthNames[month - 1]} ${year}`
---

<FullWidthLayout title={title} canonicalUrl={`${site.url}/${year}/${month}`}>
  <ArchiveSummary
    title={title}
    posts={posts}
    tracks={track.length ? [track] : []}
    km={trackDistanceKm(fullTrack)}
    previous={link(previous)}
    next={link(next)}
  />
</FullWidthLayout>
