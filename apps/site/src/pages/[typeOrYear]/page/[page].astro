---
// Type archive pagination — /likes/page/2, etc. (years are single summary pages)
// Ported from the legacy Next.js app/(default)/[typeOrYear]/page/[page]/page.tsx
//
//
// NOTE: 'notes', 'articles', and 'photos' have dedicated paginated routes
// and are deliberately excluded from this catch-all pagination route.

import { site } from '../../../lib/site'
import { getArchivePosts } from '../../../lib/archive'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import PostCard from '../../../components/PostCard.astro'
import { GrantCodesCard } from '@grantcodes/ui/components/card/index.js'
import { GrantCodesPagination } from '@grantcodes/ui/components/pagination/index.js'
import { getMetadata } from '../../../lib/metadata'

// Map URL slug (plural form) to canonical cms.postType value (singular form).
const TYPE_SLUG_MAP: Record<string, string> = {
  likes: 'like',
  replies: 'reply',
  bookmarks: 'bookmark',
  reposts: 'repost',
  checkins: 'checkin',
  events: 'event',
  videos: 'video',
  audio: 'audio',
  collections: 'collection',
  journals: 'journal',
  listens: 'listen',
  quotes: 'quotation',
  reads: 'read',
  rsvps: 'rsvp',
  watches: 'watch',
}

const { typeOrYear = '', page } = Astro.params
const pageNum = Number(page)
const siteUrl = site.url
const postType = TYPE_SLUG_MAP[typeOrYear]

const filtered = postType ? (await getArchivePosts()).filter((post) => post.postType === postType) : []
const PER_PAGE = 25
const totalPages = Math.max(Math.ceil(filtered.length / PER_PAGE), 1)
if (!postType || !Number.isInteger(pageNum) || pageNum < 2 || pageNum > totalPages) {
  return new Response(null, { status: 404 })
}

// Get metadata for page title
const meta = await getMetadata({ params: { typeOrYear, page } })
const pageTitle = meta?.title ?? `${typeOrYear} page ${page}`

const startIndex = (pageNum - 1) * PER_PAGE
const pagePosts = filtered.slice(startIndex, startIndex + PER_PAGE)

// Calculate prev/next
const prevPage = pageNum > 1 ? pageNum - 1 : null
const nextPage = pageNum < totalPages ? pageNum + 1 : null
const baseUrl = `/${typeOrYear}`
const prevHref =
  prevPage === 1 ? baseUrl : prevPage ? `${baseUrl}/page/${prevPage}` : ''
const nextHref = nextPage ? `${baseUrl}/page/${nextPage}` : ''
---

<BaseLayout title={pageTitle} canonicalUrl={`${siteUrl}${baseUrl}/page/${page}`}>
  <h2 class="page-title">{pageTitle}</h2>

  {pagePosts.length === 0 && (
    <GrantCodesCard>
      <p>No posts found for {typeOrYear} on page {pageNum}.</p>
    </GrantCodesCard>
  )}

  {pagePosts.length > 0 && (
    <>
      <div class="post-list">
        {pagePosts.map((post) => (
          <PostCard post={post} compact />
        ))}
      </div>

      <GrantCodesPagination
        previousHref={prevHref}
        nextHref={nextHref}
        page={pageNum}
        pages={totalPages}
      />
    </>
  )}
</BaseLayout>
