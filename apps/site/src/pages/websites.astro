---
// Websites / Projects index page
// Ported from apps/web/app/(default)/websites/page.tsx
// Uses websites data from apps/web/data/websites.js

import BaseLayout from '../layouts/BaseLayout.astro'
import websites from '../../../web/data/websites.js'

const siteUrl = import.meta.env.NEXT_PUBLIC_URL ?? 'https://grant.codes'
---

<BaseLayout title="Projects" canonicalUrl={`${siteUrl}/websites`}>
  <h1 class="page-title">Projects</h1>

  <div class="websites-grid">
    {websites.map((website) => (
      <a href={`/websites/${website.slug}`} class="website-tile" title={website.title}>
        <span class="screen-reader-text">{website.title}</span>
        <img
          class="website-tile__image"
          src={website.thumbnail}
          loading="lazy"
          aria-hidden="true"
          alt=""
        />
      </a>
    ))}
  </div>
</BaseLayout>

<style>
  .websites-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(2, minmax(1rem, 1fr));
    list-style: none;
  }

  .website-tile {
    display: block;
    position: relative;
    padding: 1rem;
    background-color: rgba(255, 255, 255, 0.9);
    border-radius: var(--border-radius);
    box-shadow: 0 0.5rem 3rem rgba(0, 0, 0, 0.1);
    backdrop-filter: blur(1rem);
    width: 100%;
    max-width: 16rem;
    transition: background-color 0.2s, transform 0.2s, box-shadow 0.2s, filter 0.2s;
    text-decoration: none;
  }

  .website-tile:hover,
  .website-tile:focus {
    transform: translateY(-0.3em) scale(1.03);
    background-color: rgba(255, 255, 255, 1);
    box-shadow: 0 0.5rem 3rem rgba(0, 0, 0, 0.2);
  }

  .website-tile__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
  }
</style>
