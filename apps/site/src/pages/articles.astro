---
// Articles archive — /articles
//
// Uses the Postr content collection with route-layer filtering
// instead of direct API fetching. All article-type posts from the
// canonical `posts` collection are rendered here with in-memory
// pagination.
//
// Ported from the legacy Next.js app/(default)/[typeOrYear]/page.tsx (articles case)

import { site } from '../lib/site'
import { getArchivePosts } from '../lib/archive'
import BaseLayout from '../layouts/BaseLayout.astro'
import PostCard from '../components/PostCard.astro'
import { GrantCodesCard } from '@grantcodes/ui/components/card/index.js'
import { GrantCodesPagination } from '@grantcodes/ui/components/pagination/index.js'

const siteUrl = site.url

const articles = (await getArchivePosts()).filter((post) => post.postType === 'article')

// In-memory pagination — first page, 25 per page
const PER_PAGE = 25
const totalPages = Math.max(Math.ceil(articles.length / PER_PAGE), 1)
const pageArticles = articles.slice(0, PER_PAGE)

const prevHref = ''
const nextHref = totalPages > 1 ? '/articles/page/2' : ''
---

<BaseLayout title="Articles" canonicalUrl={`${siteUrl}/articles`}>
  <h2 class="page-title">Articles</h2>

  {pageArticles.length === 0 && (
    <GrantCodesCard>
      <p>No articles found.</p>
    </GrantCodesCard>
  )}

  {pageArticles.length > 0 && (
    <>
      <div class="post-list">
        {pageArticles.map((post) => (
          <PostCard post={post} compact />
        ))}
      </div>

      {totalPages > 1 && (
        <GrantCodesPagination
          previousHref={prevHref}
          nextHref={nextHref}
          page={1}
          pages={totalPages}
        />
      )}
    </>
  )}
</BaseLayout>
