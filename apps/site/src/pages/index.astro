---
// Home: who I am, what I've built, and a few highlights from the archive.
import { site } from '../lib/site'
import BaseLayout from '../layouts/BaseLayout.astro'
import PhotosGallery from '../components/PhotosGallery.astro'
import Post from '../components/Post.astro'
import ProfilePhoto from '../components/ProfilePhoto.astro'
import ProjectList from '../components/ProjectList.astro'
import { getListedPosts } from '../lib/archive'
import websites from '../data/websites.js'

const publicPosts = await getListedPosts()
const projects = websites.slice(0, 4)
const notes = publicPosts.filter((post) => post.postType === 'note').slice(0, 3)
// Some old uploads are missing from the media store; extra photos fill the gaps their tiles leave.
const photos = publicPosts.filter((post) => post.postType === 'photo').slice(0, 16)
---

<BaseLayout title="Hi! I'm Grant" canonicalUrl={site.url}>
  <section class="intro h-card">
    <a href="/about" class="intro__photo">
      <ProfilePhoto />
    </a>
    <div class="intro__text">
      <h1 class="intro__title">Hi! I'm <span class="p-name">Grant</span></h1>
      <p class="p-note">
        I'm a frontend engineer from Scotland, living in Barcelona. I like making fun, accessible,
        sustainable websites.
      </p>
      <p class="intro__links">
        <a href="/about">More about me</a>
        <a href="/contact">Say hello</a>
        <a href="/where">Where am I?</a>
      </p>
      <a class="u-url screen-reader-text" href={site.url} rel="me">{site.name}</a>
    </div>
  </section>

  <hr />

  <section class="home-section">
    <h2>Projects</h2>
    <ProjectList projects={projects} />
    <a href="/websites">All projects</a>
  </section>

  {photos.length > 0 && (
    <section class="home-section">
      <h2>Photos</h2>
      <PhotosGallery posts={photos} type="feed" />
      <a href="/photos">All photos</a>
    </section>
  )}

  {notes.length > 0 && (
    <section class="home-section">
      <h2>Notes</h2>
      <div class="post-list">
        {notes.map((post) => <Post post={post} compact />)}
      </div>
      <a href="/updates">All updates</a>
    </section>
  )}
</BaseLayout>

<style>
  .intro {
    display: grid;
    gap: 2rem;
    align-items: center;
    padding-block-start: 1rem;
  }
  @media (min-width: 40rem) {
    .intro {
      grid-template-columns: 12rem 1fr;
    }
  }

  .intro__photo {
    display: block;
    justify-self: center;
    inline-size: 12rem;
  }
  .intro__title {
    margin: 0 0 0.5rem;
    font-size: clamp(2.5rem, 7vw, 4rem);
    line-height: 1;
  }
  .intro__text .p-note {
    margin: 0;
    font-size: 1.25rem;
    line-height: 1.5;
    text-wrap: pretty;
  }
  .intro__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin: 1rem 0 0;
    font-weight: 800;
  }

  .home-section {
    display: grid;
    gap: 1rem;
  }
  .home-section h2 {
    margin: 0;
    font-size: 2rem;
  }
  .home-section :global(.photos-gallery) {
    --gallery-columns: 4;
  }
  .home-section > a:last-child {
    justify-self: start;
    font-weight: 800;
  }
</style>
