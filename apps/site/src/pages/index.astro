---
// Home: who I am, where I've been, and a few highlights from the archive.
import { site } from '../lib/site'
import BaseLayout from '../layouts/BaseLayout.astro'
import PhotosGallery from '../components/PhotosGallery.astro'
import TrackLine from '../components/TrackLine.astro'
import PostCard from '../components/PostCard.astro'
import {
  getArchiveMonths,
  getArchivePosts,
  getMonthTrack,
  monthNames,
  trackDistanceKm,
} from '../lib/archive'

const posts = await getArchivePosts()
const publicPosts = posts.filter((post) => post.visibility === 'public')
const articles = publicPosts.filter((post) => post.postType === 'article').slice(0, 3)
const notes = publicPosts.filter((post) => post.postType === 'note').slice(0, 3)
// Some old uploads are missing from the media store; extra photos fill the gaps their tiles leave.
const photos = publicPosts.filter((post) => post.postType === 'photo').slice(0, 16)

// The most recent month with a location track.
const latestTrack = (await getArchiveMonths())
  .reverse()
  .map(([year, month]) => ({ year, month, track: getMonthTrack(year, month, 600) }))
  .find(({ track }) => track.length > 1)
const latestKm = latestTrack ? trackDistanceKm(getMonthTrack(latestTrack.year, latestTrack.month, Infinity)) : 0
---

<BaseLayout title="Hi! I'm Grant" canonicalUrl={site.url}>
  <section class="intro h-card">
    <a href="/about" class="intro__photo">
      <img class="u-photo" src="/img/me.jpg" alt={site.author.name} width="400" height="400" />
    </a>
    <svg width="0" height="0" aria-hidden="true" style="position: absolute">
      <clipPath id="photo-blob" clipPathUnits="objectBoundingBox" transform="scale(0.01)">
        <path class="photo-blob" d="M 78.956816,94.835588 C 65.625376,103.13287 42.050856,100.43882 27.470196,93.746774 12.889014,87.054987 -0.62446252,67.284526 0.02231499,50.841644 0.6688317,34.398246 8.3427947,12.782914 22.898418,6.2004991 37.454563,-0.38191765 56.971076,-2.9578225 71.920501,4.6840516 86.869927,12.325617 96.700947,35.435522 99.522777,51.125185 102.3446,66.814332 92.288777,86.538361 78.957336,94.83564 Z" />
      </clipPath>
    </svg>
    <div class="intro__text">
      <h1 class="intro__title">Hi! I'm <span class="p-name">Grant</span></h1>
      <p class="p-note">
        I'm a frontend engineer from Scotland, living in Barcelona. I like making fun, accessible,
        sustainable websites.
      </p>
      <p class="intro__links">
        <a href="/about">More about me</a>
        <a href="/contact">Say hello</a>
        <a href="/where">Where am I?</a>
      </p>
      <a class="u-url screen-reader-text" href={site.url} rel="me">{site.name}</a>
    </div>
  </section>

  {latestTrack && (
    <a class="travels" href={`/${latestTrack.year}/${latestTrack.month}`}>
      <TrackLine
        track={latestTrack.track}
        label={`My route in ${monthNames[latestTrack.month - 1]} ${latestTrack.year}`}
      />
      <span class="travels__caption">
        Where I wandered in {monthNames[latestTrack.month - 1]} {latestTrack.year}
        {latestKm > 0 && <> · {latestKm.toLocaleString('en-GB')} km</>}
      </span>
    </a>
  )}

  <hr />

  {articles.length > 0 && (
    <section class="home-section">
      <h2>Writing</h2>
      <div class="post-list">
        {articles.map((post) => <PostCard post={post} compact />)}
      </div>
      <a href="/articles">All articles</a>
    </section>
  )}

  {photos.length > 0 && (
    <section class="home-section">
      <h2>Photos</h2>
      <PhotosGallery posts={photos} type="feed" />
      <a href="/photos">All photos</a>
    </section>
  )}

  {notes.length > 0 && (
    <section class="home-section">
      <h2>Notes</h2>
      <div class="post-list">
        {notes.map((post) => <PostCard post={post} compact />)}
      </div>
      <a href="/updates">All updates</a>
    </section>
  )}
</BaseLayout>

<style>
  .intro {
    display: grid;
    gap: 2rem;
    align-items: center;
    padding-block-start: 1rem;
  }
  @media (min-width: 40rem) {
    .intro {
      grid-template-columns: 12rem 1fr;
    }
  }

  .intro__photo {
    display: block;
    justify-self: center;
    inline-size: 12rem;
    aspect-ratio: 1;
    clip-path: url(#photo-blob);
  }
  /* Slowly turn the blob shape in small steps so it never shrinks mid-morph (no-op where `d` isn't animatable, e.g. Safari). */
  @media (prefers-reduced-motion: no-preference) {
    .photo-blob {
      animation: photo-blob-morph 18s ease-in-out infinite alternate;
    }
    @keyframes photo-blob-morph {
      0% {
        d: path('M 78.96,94.84 C 65.63,103.13 42.05,100.44 27.47,93.75 12.89,87.05 -0.62,67.28 0.02,50.84 0.67,34.40 8.34,12.78 22.90,6.20 37.45,-0.38 56.97,-2.96 71.92,4.68 86.87,12.33 96.70,35.44 99.52,51.13 102.34,66.81 92.29,86.54 78.96,94.84 Z');
      }
      33% {
        d: path('M 52.66,103.31 C 36.97,103.83 17.90,89.71 8.62,76.62 -0.67,63.54 -2.48,39.66 6.30,25.74 15.08,11.82 32.53,-3.06 48.43,-1.48 64.33,0.10 82.52,7.62 91.64,21.72 100.77,35.81 97.73,60.74 92.33,75.74 86.92,90.73 68.35,102.79 52.66,103.31 Z');
      }
      67% {
        d: path('M 25.65,97.50 C 11.80,90.10 2.34,68.34 0.85,52.36 -0.65,36.39 9.72,14.80 24.28,7.14 38.85,-0.52 61.40,-4.68 74.38,4.63 87.36,13.94 99.35,29.56 100.21,46.33 101.06,63.09 85.96,83.16 73.79,93.45 61.61,103.74 39.50,104.89 25.65,97.50 Z');
      }
      100% {
        d: path('M 5.16,78.96 C -3.13,65.63 -0.44,42.05 6.25,27.47 12.95,12.89 32.72,-0.62 49.16,0.02 65.60,0.67 87.22,8.34 93.80,22.90 100.38,37.45 102.96,56.97 95.32,71.92 87.67,86.87 64.56,96.70 48.87,99.52 33.19,102.34 13.46,92.29 5.16,78.96 Z');
      }
    }
  }
  .intro__photo img {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }
  .intro__title {
    margin: 0 0 0.5rem;
    font-size: clamp(2.5rem, 7vw, 4rem);
    line-height: 1;
  }
  .intro__text .p-note {
    margin: 0;
    font-size: 1.25rem;
    line-height: 1.5;
    text-wrap: pretty;
  }
  .intro__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin: 1rem 0 0;
    font-weight: 800;
  }

  .travels {
    display: grid;
    gap: 0.5rem;
    color: inherit;
    text-decoration: none;
  }
  .travels__caption {
    justify-self: end;
    font-size: 0.9rem;
    font-weight: 700;
  }
  .travels:hover .travels__caption {
    color: var(--day-accent);
    text-decoration: underline wavy;
  }

  .home-section {
    display: grid;
    gap: 1rem;
  }
  .home-section h2 {
    margin: 0;
    font-size: 2rem;
  }
  .home-section :global(.photos-gallery) {
    --gallery-columns: 4;
  }
  .home-section > a:last-child {
    justify-self: start;
    font-weight: 800;
  }
</style>
