---
// Category detail — posts filtered by category
// Ported from the legacy Next.js app/(default)/category/[category]/page.tsx
//
// Uses the Postr content collection with route-layer filtering
// instead of direct API fetching. Posts matching the category are
// filtered in-memory from the canonical `posts` collection.

import { site } from '../../lib/site'
import { getArchivePosts } from '../../lib/archive'
import BaseLayout from '../../layouts/BaseLayout.astro'
import PostCard from '../../components/PostCard.astro'
import { GrantCodesPagination } from '@grantcodes/ui/components/pagination/index.js'
import getCategories from '../../lib/categories'
import { categorySlug as slugOf } from '../../lib/category-slug'

const siteUrl = site.url
const { category: categorySlug } = Astro.params

// Look up the category
const allCategories = await getCategories()
const category = allCategories.find((cat) => cat.slug === categorySlug)
if (!category) return new Response(null, { status: 404 })

const pageTitle = `Category: ${category.name}`

const filtered = (await getArchivePosts()).filter((post) =>
  post.categories.some((name) => slugOf(name) === category.slug)
)

// In-memory pagination — first page, 25 per page
const PER_PAGE = 25
const totalPages = Math.max(Math.ceil(filtered.length / PER_PAGE), 1)
const posts = filtered.slice(0, PER_PAGE)

// Pagination
const prevHref = ''
const nextHref = totalPages > 1 ? `/category/${categorySlug}/page/2` : ''
---

<BaseLayout
  title={pageTitle}
  canonicalUrl={`${siteUrl}/category/${categorySlug}`}
>
  <h2 class="page-title">{pageTitle}</h2>

  <div class="post-list">
    {posts.map((post) => (
      <PostCard post={post} compact />
    ))}
  </div>

  {totalPages > 1 && (
    <GrantCodesPagination
      previousHref={prevHref}
      nextHref={nextHref}
      page={1}
      pages={totalPages}
    />
  )}
</BaseLayout>
