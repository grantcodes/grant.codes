---
// Category pagination — /category/:category/page/:page
// Ported from the legacy Next.js app/(default)/category/[category]/page/[page]/page.tsx

import { site } from '../../../../lib/site'
import { getArchivePosts } from '../../../../lib/archive'
import BaseLayout from '../../../../layouts/BaseLayout.astro'
import PostCard from '../../../../components/PostCard.astro'
import { GrantCodesPagination } from '@grantcodes/ui/components/pagination/index.js'
import getCategories from '../../../../lib/categories'
import { categorySlug as slugOf } from '../../../../lib/category-slug'

const siteUrl = site.url
const { category: categorySlug, page } = Astro.params
const pageNum = Number(page)

const category = (await getCategories()).find((cat) => cat.slug === categorySlug)
const filtered = category
  ? (await getArchivePosts()).filter((post) => post.categories.some((name) => slugOf(name) === category.slug))
  : []

// In-memory pagination
const PER_PAGE = 25
const totalPages = Math.max(Math.ceil(filtered.length / PER_PAGE), 1)
if (!category || !Number.isInteger(pageNum) || pageNum < 2 || pageNum > totalPages) {
  return new Response(null, { status: 404 })
}
const startIndex = (pageNum - 1) * PER_PAGE
const posts = filtered.slice(startIndex, startIndex + PER_PAGE)
const pageTitle = `Category: ${category.name} page ${pageNum}`

// Calculate prev/next
const prevPage = pageNum - 1
const nextPage = pageNum < totalPages ? pageNum + 1 : null
const baseUrl = `/category/${categorySlug}`
const prevHref = prevPage === 1 ? baseUrl : `${baseUrl}/page/${prevPage}`
const nextHref = nextPage ? `${baseUrl}/page/${nextPage}` : ''
---

<BaseLayout title={pageTitle} canonicalUrl={`${siteUrl}${baseUrl}/page/${page}`}>
  <h2 class="page-title">{pageTitle}</h2>

  <div class="post-list">
    {posts.map((post) => (
      <PostCard post={post} compact />
    ))}
  </div>

  <GrantCodesPagination
    previousHref={prevHref}
    nextHref={nextHref}
    page={pageNum}
    pages={totalPages}
  />
</BaseLayout>
