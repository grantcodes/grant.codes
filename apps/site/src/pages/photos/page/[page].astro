---
// Photos gallery pagination — /photos/page/2, /photos/page/3, etc.
// Ported from the legacy Next.js app/(full-width)/photos/page/[page]/page.tsx

import { site } from '../../../lib/site'
import { getArchivePosts } from '../../../lib/archive'
import FullWidthLayout from '../../../layouts/FullWidthLayout.astro'
import PhotosGallery from '../../../components/PhotosGallery.astro'
import { GrantCodesCard } from '@grantcodes/ui/components/card/index.js'
import { GrantCodesPagination } from '@grantcodes/ui/components/pagination/index.js'

const { page } = Astro.params

const siteUrl = site.url
const pageNum = Number(page)

const allPhotos = (await getArchivePosts()).filter((post) => post.postType === 'photo')

const PER_PAGE = 120
const totalPages = Math.max(Math.ceil(allPhotos.length / PER_PAGE), 1)
if (!Number.isInteger(pageNum) || pageNum < 2 || pageNum > totalPages) {
  return new Response(null, { status: 404 })
}
const startIndex = (pageNum - 1) * PER_PAGE
const posts = allPhotos.slice(startIndex, startIndex + PER_PAGE)

// Calculate prev/next
const prevPage = pageNum > 1 ? pageNum - 1 : null
const nextPage = pageNum < totalPages ? pageNum + 1 : null
const prevHref = prevPage ? (prevPage === 1 ? '/photos' : `/photos/page/${prevPage}`) : ''
const nextHref = nextPage ? `/photos/page/${nextPage}` : ''
---

<FullWidthLayout title={`Photos page ${page}`} canonicalUrl={`${siteUrl}/photos/page/${page}`} full>
  <h2 class="page-title">Photos page {page}</h2>

  {posts.length === 0 && (
    <GrantCodesCard>
      <p>No photos found on page {pageNum}.</p>
    </GrantCodesCard>
  )}

  {posts.length > 0 && (
    <>
      <div class="photos-page"><PhotosGallery posts={posts} type="feed" /></div>

      <GrantCodesPagination
        previousHref={prevHref}
        nextHref={nextHref}
        page={pageNum}
        pages={totalPages}
      />
    </>
  )}
</FullWidthLayout>
