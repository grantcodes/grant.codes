---
// Photos gallery pagination — /photos/page/2, /photos/page/3, etc.
// Ported from the legacy Next.js app/(full-width)/photos/page/[page]/page.tsx
//
// Uses the Postr content collection with route-layer filtering.
// Computes total pages from the in-memory collection so that
// every page is pre-rendered at build time.

import FullWidthLayout from '../../../layouts/FullWidthLayout.astro'
import PhotosGallery from '../../../components/PhotosGallery.astro'
import { getCollection } from 'astro:content'

export async function getStaticPaths() {
  const allEntries = await getCollection('posts')
  const photoCount = allEntries.filter(
    (e) => e.data?.cms?.postType === 'photo'
  ).length

  const PER_PAGE = 50
  const totalPages = Math.max(Math.ceil(photoCount / PER_PAGE), 1)

  // Pre-generate all pages (page 1 is /photos, start from page 2)
  return Array.from({ length: totalPages - 1 }, (_, i) => ({
    params: { page: String(i + 2) },
  }))
}

const { page } = Astro.params

const siteUrl = import.meta.env.NEXT_PUBLIC_URL ?? 'https://grant.codes'
const pageNum = parseInt(page ?? '2')

// Fetch and filter photos from the canonical collection.
// Sorting by canonical date (newest first) ensures deterministic output.
const allEntries = await getCollection('posts')
const allPhotos = allEntries
  .map((entry) => entry.data)
  .filter((post) => post?.cms?.postType === 'photo')
  .sort((a, b) => {
    const dateA = a?._postr?.date ?? ''
    const dateB = b?._postr?.date ?? ''
    return dateB.localeCompare(dateA)
  })

// In-memory pagination
const PER_PAGE = 50
const totalPages = Math.max(Math.ceil(allPhotos.length / PER_PAGE), 1)
const startIndex = (pageNum - 1) * PER_PAGE
const posts = allPhotos.slice(startIndex, startIndex + PER_PAGE)

// Calculate prev/next
const prevPage = pageNum > 1 ? pageNum - 1 : null
const nextPage = pageNum < totalPages ? pageNum + 1 : null
const prevHref = prevPage ? (prevPage === 1 ? '/photos' : `/photos/page/${prevPage}`) : ''
const nextHref = nextPage ? `/photos/page/${nextPage}` : ''
---

<FullWidthLayout title={`Photos page ${page}`} canonicalUrl={`${siteUrl}/photos/page/${page}`}>
  <h2 class="page-title">Photos page {page}</h2>

  {posts.length === 0 && (
    <div class="card card--glass" style="text-align: center; padding: 2rem;">
      <p>No photos found on page {pageNum}.</p>
    </div>
  )}

  {posts.length > 0 && (
    <>
      <PhotosGallery posts={posts} type="feed" maxWidth={20} />

      <grantcodes-pagination
        previous-href={prevHref}
        next-href={nextHref}
        page={pageNum}
        pages={totalPages}
      />
    </>
  )}
</FullWidthLayout>
