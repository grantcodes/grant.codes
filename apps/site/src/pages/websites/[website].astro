---
// Website detail page
// Ported from the legacy Next.js app/(default)/websites/[website]/page.tsx
// Wave 11: migrated to SSR GrantCodesCard with nav links in footer slot

import BaseLayout from '../../layouts/BaseLayout.astro'
import { GrantCodesCard } from '@grantcodes/ui/components/card/index.js'
import { GrantCodesButton } from '@grantcodes/ui/components/button/index.js'
import { GrantCodesIcon } from '@grantcodes/ui/components/icon/index.js'
import { ArrowLeft, ExternalLink } from '@grantcodes/ui/icons'
import websites from '../../data/websites.js'

const siteUrl = import.meta.env.NEXT_PUBLIC_URL ?? 'https://grant.codes'

export async function getStaticPaths() {
  return websites.map((website) => ({
    params: { website: website.slug },
  }))
}

const { website: slug } = Astro.params
const website = websites.find((w) => w.slug === slug)

if (!website) {
  return Astro.redirect('/websites', 302)
}

const { title, screenshot, url, content = '' } = website
---

<BaseLayout title={title} canonicalUrl={`${siteUrl}/websites/${slug}`}>
  <GrantCodesCard>
    <header >
      {screenshot && (
        <img
          src={screenshot}
          alt={`${title} Screenshot`}
          loading="lazy"
        />
      )}
      <h1 class="p-name post__title">{title}</h1>
    </header>

    <main class="website-content" set:html={content} />

    <div class="website-nav-row">
        <GrantCodesButton href="/websites" variant="ghost" color="neutral">
        <grantcodes-icon set:html={ArrowLeft}></grantcodes-icon>
        All Projects
      </GrantCodesButton>
      {url && (
        <GrantCodesButton href={url} target="_blank" rel="noopener noreferrer">
          View Project
          <grantcodes-icon set:html={ExternalLink}></grantcodes-icon>
        </GrantCodesButton>
      )}
    </div>
  </GrantCodesCard>
</BaseLayout>

<style>
  .website-nav-row {
      display: flex;
      flex-direction: row;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: var(--g-spacing-sm);
  }
</style>
