---
// A location track drawn as a single contour-style line (no map tiles).
import type { Track } from '../lib/archive'

export interface Props {
  track: Track
  label: string
}

const { track, label } = Astro.props
const width = 600
const height = 160
const pad = 8

// Equirectangular projection, scaled to fit while keeping the aspect ratio.
const lats = track.map(([lat]) => lat)
const lngs = track.map(([, lng]) => lng)
const midLat = ((Math.min(...lats) + Math.max(...lats)) / 2) * (Math.PI / 180)
const xs = lngs.map((lng) => lng * Math.cos(midLat))
const minX = Math.min(...xs)
const maxY = Math.max(...lats)
const spanX = Math.max(...xs) - minX || 1
const spanY = maxY - Math.min(...lats) || 1
const scale = Math.min((width - pad * 2) / spanX, (height - pad * 2) / spanY)
const offsetX = (width - spanX * scale) / 2
const offsetY = (height - spanY * scale) / 2
const d = track
  .map(([lat], i) => {
    const x = offsetX + (xs[i] - minX) * scale
    const y = offsetY + (maxY - lat) * scale
    return `${i === 0 ? 'M' : 'L'}${x.toFixed(1)} ${y.toFixed(1)}`
  })
  .join('')
---

{track.length > 1 && (
  <svg class="track-line" viewBox={`0 0 ${width} ${height}`} role="img" aria-label={label}>
    <path d={d} pathLength="1" />
  </svg>
)}

<style>
  .track-line {
    display: block;
    inline-size: 100%;
    block-size: auto;
    overflow: visible;
  }
  .track-line path {
    fill: none;
    stroke: var(--day-accent);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  @media (prefers-reduced-motion: no-preference) {
    .track-line path {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      animation: track-draw 2.5s 0.4s ease-out forwards;
    }
    @keyframes track-draw {
      to {
        stroke-dashoffset: 0;
      }
    }
  }
</style>
