---
// Link preview of a page a post responds to (like, repost, bookmark, reply), from the
// h-entry postr fetched (or imported from 1.x) for it. `relation` is its microformat class.
import type { Reference } from '../lib/reference'

export interface Props {
  reference: Reference
  relation?: string
}

const { reference, relation = '' } = Astro.props
---

<a class={`reference h-cite ${relation}`} href={reference.url}>
  {reference.image && (
    <img
      class="reference__image u-photo"
      src={reference.image}
      alt=""
      loading="lazy"
      referrerpolicy="no-referrer"
      onerror="this.remove()"
    />
  )}
  <span class="reference__text">
    {reference.name && <strong class="reference__name p-name">{reference.name}</strong>}
    {reference.excerpt && <span class="reference__excerpt p-summary">{reference.excerpt}</span>}
    <span class="reference__host">{reference.host}</span>
  </span>
</a>

<style>
  .reference {
    display: flex;
    gap: 0.75rem;
    padding: 0.75rem;
    border: var(--g-border-width-sm) solid var(--g-color-border-default);
    border-radius: var(--g-border-radius-md);
    color: inherit;
    text-decoration: none;
  }
  .reference:hover {
    border-color: var(--day-accent);
  }
  .reference__image {
    flex: 0 0 5rem;
    inline-size: 5rem;
    block-size: 5rem;
    object-fit: cover;
    border-radius: var(--g-border-radius-sm);
  }
  .reference__text {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-inline-size: 0;
  }
  .reference__name {
    line-height: 1.25;
  }
  .reference__excerpt {
    font-size: 0.85rem;
    color: var(--g-color-content-subtle);
  }
  .reference__host {
    font-size: 0.75rem;
    color: var(--day-accent);
    overflow-wrap: anywhere;
  }
</style>
