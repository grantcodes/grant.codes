---
// A post on this site through the shared mf2 `Post`: its photos keep the site's srcset, fallback
// and zoom handling, and the pages it responds to show as embeds or link previews.
import type { PostData } from '@postr/astro'
import { EntryMedia, Post as Entry } from '@grantcodes/astro/post'
import { GrantCodesGallery } from '@grantcodes/ui/components/gallery/index.js'
import { GrantCodesPostContext } from '@grantcodes/ui/components/post/post-context.js'
import { citationOptions, contextLabels, contextsOf, displayUrl, first, mediaColumns, text, type Mf2Item } from '@grantcodes/ui/mf2'
import PhotosGallery from './PhotosGallery.astro'
import ResponseTarget from './ResponseTarget.astro'
import { getChildren } from '../lib/post-children'
import { toEntry, postOptions } from '../lib/post-entry'
import { onImageError, photoImage } from '../lib/photo'
import { hasResponseTarget } from '../lib/reference'

export interface Props {
  post: PostData
  /** List card: articles show their summary, only the first photo, and no responses. */
  compact?: boolean
}

const { post, compact = false } = Astro.props
const entry = toEntry(post)
const options = postOptions(post, compact ? { compact } : { headingLevel: 1 })
const url = first(entry, 'url') as string

const pick = (...keys: string[]): Mf2Item => ({
  type: entry.type,
  properties: Object.fromEntries(keys.map((key) => [key, entry.properties[key]])),
})
// Cards link their first photo to the post; a single post shows them all, each opening full size.
const photos = compact ? post.photos.slice(0, 1) : post.photos
const columns = mediaColumns(photos.length)
const sizes = compact ? '(min-width: 44rem) 42rem, 100vw' : `(min-width: 48rem) ${46 / columns}rem, ${100 / columns}vw`
const onPhotoError = onImageError('a')
const children = await getChildren(post)

const contexts = contextsOf(entry)
const rsvp = text(first(entry, 'rsvp'))
---

<Entry entry={entry} options={options}>
  <Fragment slot="contexts">
    {contexts.map(({ type, property, url, citation }) => {
      const reference = post.references[url]
      const rich = !citation && hasResponseTarget(url, reference)
      return (
        <GrantCodesPostContext type={type}>
          {type === 'rsvp' ? <>RSVPed <span class="p-rsvp">{rsvp}</span> to </> : `${contextLabels[type]} `}
          {/* A preview or citation carries the property itself, so the link must not repeat it. */}
          <a class={citation || rich ? undefined : `u-${property}`} href={url}>{displayUrl(url)}</a>
          {citation && (
            <div slot="citation">
              <Entry entry={citation} class={`u-${property} h-cite`} options={citationOptions(options)} />
            </div>
          )}
          {rich && (
            <div slot="citation">
              <ResponseTarget url={url} entry={reference} relation={`u-${property}`} />
            </div>
          )}
        </GrantCodesPostContext>
      )
    })}
  </Fragment>

  <Fragment slot="media">
    <EntryMedia entry={pick('featured')} />
    {photos.length > 0 && (
      <GrantCodesGallery style={`--gallery-columns: ${columns}`}>
        {photos.map((photo) => {
          const image = photoImage(photo, compact ? '700' : '1800', sizes)
          // The srcset picks the copy to load; src stays the original, which is what u-photo reports.
          const src = image.srcset ? photo.url : image.src
          return (
            <a
              class="post-photo"
              href={compact ? url : photo.url}
              data-zoom={compact ? undefined : ''}
              data-width={compact ? undefined : photo.width}
              data-height={compact ? undefined : photo.height}
            >
              <img
                class="u-photo"
                src={src}
                srcset={image.srcset}
                sizes={image.sizes}
                data-fallback={image.fallback}
                width={image.width}
                height={image.height}
                onerror={onPhotoError}
                alt={photo.alt ?? ''}
                loading="lazy"
              />
            </a>
          )
        })}
      </GrantCodesGallery>
    )}
    <EntryMedia entry={pick('video', 'audio')} />
    {children.length > 0 && <PhotosGallery posts={children} type="collection" />}
  </Fragment>
</Entry>
