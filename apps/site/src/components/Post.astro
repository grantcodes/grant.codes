---
// Full MF2-aware post renderer for single post pages
// Ported from the legacy Next.js components/Post/index.tsx and supporting components
//
// Supports: note, article, photo, reply, repost, like, bookmark, video,
//           audio, event, checkin, rsvp, quotation, collection
//
// Renders proper MF2 classes for IndieWeb semantics:
//   h-entry, p-name, e-content, u-photo, u-url, dt-published, p-category,
//   u-like-of, u-repost-of, u-in-reply-to, u-bookmark-of, u-featured,
//   u-video, u-audio, dt-start, dt-end, p-location, p-rsvp, u-syndication

import PostFooter from './PostFooter.astro'
import PostCard from './PostCard.astro'
import PostContent from './PostContent.astro'
import { GrantCodesButton } from '@grantcodes/ui/components/button/index.js'
import { GrantCodesIcon } from '@grantcodes/ui/components/icon/index.js'
import { Heart, Bookmark, Repeat2, Reply } from '@grantcodes/ui/icons'
import { normalizeInternalUrl } from '../lib/url'
import { getUrl } from '../lib/post-mentions'
import { getPhotoUrl, getPhotoAlt, getMediaUrl } from '../lib/post-media'

export interface Props {
  post: any
  compact?: boolean
}

const { post, compact = false } = Astro.props

const hasPost = !!(post && post.properties)

// Guard: if no post, render nothing
if (!hasPost) return

const properties = post.properties
const postType = post?.cms?.postType ?? null

const name = properties.name?.[0] ?? null
const content = properties.content?.[0] ?? null
const summary = properties.summary?.[0] ?? null
const url = normalizeInternalUrl(properties.url?.[0])
const featured = properties.featured?.[0] ?? null

// Mention properties
const likeOf = properties['like-of']?.[0] ?? null
const repostOf = properties['repost-of']?.[0] ?? null
const inReplyTo = properties['in-reply-to']?.[0] ?? null
const bookmarkOf = properties['bookmark-of']?.[0] ?? null
const quotationOf = properties['quotation-of']?.[0] ?? null
const rsvp = properties.rsvp?.[0] ?? null

// Media
const photo = properties.photo ?? []
const video = properties.video ?? []
const audio = properties.audio ?? []

// Event properties
const start = properties.start?.[0] ?? null
const end = properties.end?.[0] ?? null
const location = properties.location?.[0] ?? null

// Post children (gallery of referenced posts)
const children = post.children ?? null

// References (like-of, repost-of referenced post data)
const references = post.references ?? null

const authorName = import.meta.env.NEXT_PUBLIC_AUTHOR_NAME ?? 'Grant Richmond'
---

<article
  class={`post post--${postType ?? 'unknown'} h-entry`}
>

  {/* Featured image (e.g., article header image) */}
  {featured && (
    <header class="card__breakout post__header post__header--featured" style={`background-image: url(${featured})`}>
      <data class="u-featured" value={featured} />
      {name && <h1 class="post__title p-name">{name}</h1>}
    </header>
  )}

  {/* Name/title (not featured header) */}
  {!featured && name && (
    <header class="post__header card__breakout--padded">
      <h1 class="post__title p-name">{name}</h1>
    </header>
  )}

  {/* ── Mention actions (like, repost, reply, bookmark, quotation) ── */}

  {likeOf && (
    <p class="card__breakout post__action">
      <grantcodes-icon style="font-size: 16px" set:html={Heart}></grantcodes-icon>
      Liked{' '}
      <a class="u-like-of" href={getUrl(likeOf)}>{getUrl(likeOf).replace(/^https?:\/\//, '')}</a>
    </p>
  )}

  {bookmarkOf && (
    <p class="card__breakout post__action">
      <grantcodes-icon style="font-size: 16px" set:html={Bookmark}></grantcodes-icon>
      Bookmarked{' '}
      <a class="u-bookmark-of" href={getUrl(bookmarkOf)}>{getUrl(bookmarkOf).replace(/^https?:\/\//, '')}</a>
    </p>
  )}

  {repostOf && (
    <p class="card__breakout post__action">
      <grantcodes-icon style="font-size: 16px" set:html={Repeat2}></grantcodes-icon>
      Reposted{' '}
      <a class="u-repost-of" href={getUrl(repostOf)}>{getUrl(repostOf).replace(/^https?:\/\//, '')}</a>
    </p>
  )}

  {quotationOf && (
    <p class="card__breakout post__action">
      Quoted{' '}
      <a class="u-quotation-of" href={getUrl(quotationOf)}>{getUrl(quotationOf).replace(/^https?:\/\//, '')}</a>
    </p>
  )}

  {inReplyTo && (
    <p class="card__breakout post__action">
      <grantcodes-icon style="font-size: 16px" set:html={Reply}></grantcodes-icon>
      {rsvp ? (
        <>
          RSVPed <span class="p-rsvp">{rsvp}</span> to{' '}
        </>
      ) : 'Replied to '}
      <a class="u-in-reply-to" href={getUrl(inReplyTo)}>{getUrl(inReplyTo).replace(/^https?:\/\//, '')}</a>
    </p>
  )}

  {/* ── Photos ── */}
  {photo.length > 0 && (
    <div class="card__breakout post__photos">
      {photo.map((p: any, i: number) => {
        const src = getPhotoUrl(p)
        const alt = getPhotoAlt(p)
        return (
          <figure>
            <img src={src} alt={alt} loading="lazy" />
            <data class="u-photo" value={src} />
          </figure>
        )
      })}
    </div>
  )}

  {/* ── Video ── */}
  {video.length > 0 && video.map((v: any) => (
    <div class="card__breakout">
      <video class="u-video" src={getMediaUrl(v)} controls />
    </div>
  ))}

  {/* ── Audio ── */}
  {audio.length > 0 && audio.map((a: any) => (
    <div class="card__breakout">
      <audio class="u-audio" src={getMediaUrl(a)} controls></audio>
    </div>
  ))}

  {/* ── Summary (shown for articles in compact or without content) ── */}
  {summary && ((compact && postType === 'article') || !content) && (
    <div class="card__breakout--padded">
      <p class="p-summary">{typeof summary === 'string' ? summary : summary.value ?? ''}</p>
    </div>
  )}

  {/* ── Content ── */}
  {content && (
    <PostContent content={content} />
  )}

  {/* Compact mode: article read more link */}
  {compact && postType === 'article' && content && url && (
    <div class="card__breakout--padded" style="text-align: center; padding: 1rem;">
      <GrantCodesButton href={url} aria-hidden="true">Read full post</GrantCodesButton>
    </div>
  )}

  {/* ── Event properties (start/end) ── */}
  {start && (
    <div class="card__breakout--padded">
      <h6 style="margin-bottom: 0;">Start</h6>
      <time class="dt-start" datetime={start}>{new Date(start).toLocaleString()}</time>
    </div>
  )}
  {end && (
    <div class="card__breakout--padded">
      <h6 style="margin-bottom: 0;">End</h6>
      <time class="dt-end" datetime={end}>{new Date(end).toLocaleString()}</time>
    </div>
  )}

  {/* ── Location ── */}
  {location && location.properties?.name?.[0] && location.properties?.url?.[0] && (
    <div class="card__breakout--padded p-location h-card">
      At{' '}
      <a class="u-url p-name p-org" href={location.properties.url[0]}>
        {location.properties.name[0]}
      </a>
    </div>
  )}

  {/* ── Post children (gallery of referenced posts) ── */}
  {children && Array.isArray(children) && children.length > 0 && (
    <div class="card__breakout post__children">
      {children.map((child: any) => (
        <PostCard post={child} compact />
      ))}
    </div>
  )}

  {/* ── References (like-of/repost-of referenced post data) ── */}
  {/* Only show references for post types where they provide meaningful context */}
  {references && Object.keys(references).length > 0 && (likeOf || repostOf || inReplyTo || bookmarkOf) && (
    <div class="card__breakout post__references">
      {Object.values(references).map((refPost: any) => (
        <PostCard post={refPost} compact />
      ))}
    </div>
  )}

  {/* ── Footer ── */}
  <PostFooter post={post} compact={compact} />

  <!-- Hidden author h-card -->
  <span class="p-author h-card screen-reader-text">
    <span class="p-name">{authorName}</span>
  </span>

</article>

<style is:global>
  .card__breakout {
    display: block;
    overflow: hidden;
    clear: both;
    background-color: var(--g-color-background-subtle);
    margin: var(--card-padding) 0 calc(-1 * var(--card-padding));
  }
  .card__breakout + .card__breakout {
    margin-top: calc(-1 * var(--card-padding));
  }
  .card__breakout:first-child {
    margin-top: calc(-1 * var(--card-padding));
  }
  .card__breakout:last-child {
    margin-bottom: calc(-1 * var(--card-padding));
  }
  .card__breakout > img {
    display: block;
    width: 100%;
  }
  .card__breakout--padded {
    padding: var(--card-padding);
  }

  .post__action {
    margin: 0;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-size: 0.714rem;
  }
  .post__action grantcodes-icon {
    vertical-align: middle;
    margin-right: 0.3em;
  }

  .post__content > p:first-child {
    margin-top: 0;
  }
</style>
