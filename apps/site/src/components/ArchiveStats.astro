---
// Stat tiles: post counts per type (linking to their archives) plus any extra stats.
import { typeLabel } from '../lib/post-type-info'

export interface Props {
  counts: Array<[type: string, count: number]>
  extra?: Array<{ emoji: string; value: string; label: string }>
}

const { counts, extra = [] } = Astro.props
const total = counts.reduce((sum, [, count]) => sum + count, 0)
---

<ul class="archive-stats" role="list">
  <li class="archive-stats__item archive-stats__item--total">
    <span class="archive-stats__value">{total}</span>
    <span class="archive-stats__label">posts</span>
  </li>
  {extra.map((stat) => (
    <li class="archive-stats__item">
      <span class="archive-stats__emoji" aria-hidden="true">{stat.emoji}</span>
      <span class="archive-stats__value">{stat.value}</span>
      <span class="archive-stats__label">{stat.label}</span>
    </li>
  ))}
  {counts.map(([type, count]) => {
    const info = typeLabel(type)
    return (
      <li class="archive-stats__item">
        <span class="archive-stats__emoji" aria-hidden="true">{info.emoji}</span>
        <span class="archive-stats__value">{count}</span>
        {info.href ? (
          <a class="archive-stats__label" href={info.href}>{info.label.toLowerCase()}</a>
        ) : (
          <span class="archive-stats__label">{info.label.toLowerCase()}</span>
        )}
      </li>
    )
  })}
</ul>

<style>
  .archive-stats {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(7rem, 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .archive-stats__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15rem;
    padding: 0.75rem 0.5rem;
    border-radius: var(--g-border-radius-md);
    background: var(--g-color-background-default);
    text-align: center;
  }
  .archive-stats__item--total {
    background: var(--day-main);
    color: var(--day-on-main, var(--g-color-content-knockout));
  }
  .archive-stats__emoji {
    font-size: 1.5rem;
  }
  .archive-stats__value {
    font-size: 1.75rem;
    font-weight: 900;
    line-height: 1;
  }
  .archive-stats__label {
    font-size: 0.85rem;
  }
</style>
