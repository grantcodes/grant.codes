---
// Post photo renderer — renders photo array with u-photo MF2 class
// Ported from the legacy Next.js components/Post/Photo/Photo.tsx

import { getPhotoUrl, getPhotoAlt } from '../lib/post-media'

export interface Props {
  photos: any[]
  permalink?: string
}

const { photos, permalink } = Astro.props
---

{photos && photos.length > 0 && (
  <div class="card__breakout post__photos">
    {photos.map((photo) => {
      const src = getPhotoUrl(photo)
      const alt = getPhotoAlt(photo)
      return (
        <figure>
          {permalink ? (
            <a href={permalink}>
              <img src={src} alt={alt} loading="lazy" />
            </a>
          ) : (
            <img src={src} alt={alt} loading="lazy" />
          )}
          <data class="u-photo" value={src} />
        </figure>
      )
    })}
  </div>
)}
