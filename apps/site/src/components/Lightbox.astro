---
// Full-size image viewer for any `a[data-zoom]` link (its href is the full image).
import { X } from 'lucide-static'
---

<dialog class="lightbox" closedby="any" aria-label="Image viewer">
  <figure class="lightbox__figure">
    <img class="lightbox__image" alt="" />
    <figcaption class="lightbox__caption">
      <a class="lightbox__permalink" hidden>View post</a>
    </figcaption>
  </figure>
  <form method="dialog">
    <button class="lightbox__close" aria-label="Close">
      <grantcodes-icon set:html={X}></grantcodes-icon>
    </button>
  </form>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('dialog.lightbox')
  const image = dialog?.querySelector<HTMLImageElement>('.lightbox__image')
  const permalink = dialog?.querySelector<HTMLAnchorElement>('.lightbox__permalink')

  if (dialog && image && permalink) {
    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Element)) return
      const link = event.target.closest<HTMLAnchorElement>('a[data-zoom]')
      if (!link || event.metaKey || event.ctrlKey || event.shiftKey) return
      event.preventDefault()
      image.src = link.href
      image.alt = link.querySelector('img')?.alt ?? ''
      permalink.hidden = !link.dataset.permalink
      if (link.dataset.permalink) permalink.href = link.dataset.permalink
      dialog.showModal()
    })

    dialog.addEventListener('close', () => image.removeAttribute('src'))

    // Light dismiss for browsers without `closedby` (Safari).
    if (!('closedBy' in HTMLDialogElement.prototype)) {
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close()
      })
    }
  }
</script>

<style is:global>
  .lightbox {
    max-inline-size: 95vw;
    max-block-size: 95dvh;
    padding: 0;
    border: none;
    background: transparent;
    overflow: visible;
  }
  .lightbox:modal {
    overscroll-behavior: contain;
  }
  .lightbox::backdrop {
    background-color: rgb(0 0 0 / 0.9);
    overflow: hidden;
    overscroll-behavior: contain;
  }
  .lightbox__figure {
    margin: 0;
  }
  .lightbox__image {
    display: block;
    max-inline-size: 95vw;
    max-block-size: 85dvh;
    object-fit: contain;
  }
  /* Override the site-wide overlaid figcaption (absolute, gradient). */
  .lightbox__caption {
    position: static;
    padding: 0.5rem 0 0;
    background: none;
    text-align: center;
  }
  .lightbox__permalink {
    color: white;
  }
  .lightbox__close {
    position: fixed;
    inset-block-start: 1rem;
    inset-inline-end: 1rem;
    padding: 0.25rem;
    border: none;
    background: none;
    color: white;
    font-size: 1.5rem;
    cursor: pointer;
  }
  a[data-zoom] {
    cursor: zoom-in;
  }
</style>
