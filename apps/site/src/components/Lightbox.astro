---
// Full-size image viewer for any `a[data-zoom]` link (its href is the full image).
import { X } from 'lucide-static'
---

<dialog class="lightbox" closedby="any" aria-label="Image viewer">
  <img class="lightbox__image" alt="" />
  <form method="dialog">
    <button class="lightbox__close" aria-label="Close">
      <grantcodes-icon set:html={X}></grantcodes-icon>
    </button>
  </form>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('dialog.lightbox')
  const image = dialog?.querySelector<HTMLImageElement>('.lightbox__image')

  if (dialog && image) {
    document.addEventListener('click', async (event) => {
      if (!(event.target instanceof Element)) return
      const link = event.target.closest<HTMLAnchorElement>('a[data-zoom]')
      if (!link || event.metaKey || event.ctrlKey || event.shiftKey) return
      event.preventDefault()
      image.src = link.href
      image.alt = link.querySelector('img')?.alt ?? ''
      const { width, height } = link.dataset
      if (width && height) {
        // Known dimensions: size it to fit the screen now, so the dialog can open straight away.
        const w = Number(width)
        const h = Number(height)
        image.style.aspectRatio = `${w} / ${h}`
        image.style.inlineSize = `${Math.min(w, innerWidth * 0.95, (innerHeight * 0.85 * w) / h)}px`
      } else {
        // Otherwise open once it's decoded (or after 2s), so the dialog doesn't grow as it loads.
        image.style.aspectRatio = ''
        image.style.inlineSize = ''
        document.documentElement.style.cursor = 'progress'
        await Promise.race([image.decode().catch(() => {}), new Promise((r) => setTimeout(r, 2000))])
        document.documentElement.style.cursor = ''
      }
      dialog.showModal()
    })

    // Clear after the exit transition so the image doesn't vanish mid-fade.
    dialog.addEventListener('close', () =>
      setTimeout(() => dialog.open || image.removeAttribute('src'), 300)
    )

    // Light dismiss for browsers without `closedby` (Safari).
    if (!('closedBy' in HTMLDialogElement.prototype)) {
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close()
      })
    }
  }
</script>

<style is:global>
  .lightbox {
    max-inline-size: 95vw;
    max-block-size: 95dvh;
    padding: 0;
    border: none;
    background: transparent;
    overflow: visible;
  }
  .lightbox:modal {
    overscroll-behavior: contain;
  }
  .lightbox::backdrop {
    overflow: hidden;
    overscroll-behavior: contain;
  }
  .lightbox__image {
    display: block;
    max-inline-size: 95vw;
    max-block-size: 85dvh;
    object-fit: contain;
  }
  /* Above the dialog's corner: the dialog's scale animation makes it the containing block. */
  .lightbox__close {
    position: absolute;
    inset-block-end: 100%;
    inset-inline-end: 0;
    padding: 0.25rem;
    border: none;
    background: none;
    color: white;
    font-size: 1.5rem;
    cursor: pointer;
  }
  a[data-zoom] {
    cursor: zoom-in;
  }
</style>
