---
// Post content renderer — safely renders HTML content with MF2 e-content class
// Ported from the legacy Next.js components/Post/Content.js
//
// Shared Astro primitive: delegates to `renderContentHtml()` from
// `lib/post-content.ts`. Use this component instead of inline `set:html`
// when you want an Astro-component boundary for the e-content div.
// Currently used directly by Post.astro and PostCard.astro via the lib helper,
// and available as a standalone primitive for any call site.

import { renderContentHtml } from '../lib/post-content'

export interface Props {
  content: any
}

const { content } = Astro.props
---

{content && (
  <div class="post__content e-content" set:html={renderContentHtml(content)} />
)}
