---
// Post card for list rendering — compact MF2-aware post entry
// Ported from the legacy Next.js components/Post/index.tsx + PostList/Timeline.js
// Wave 8: enhanced with proper action labels, hidden author h-card, better mention rendering

import { site } from '../lib/site'
import { Heart, Bookmark, Repeat2, Reply } from 'lucide-static'
import { getSiteUrl, normalizeInternalUrl } from '../lib/url'
import PostContent from './PostContent.astro'
import { GrantCodesButton } from '@grantcodes/ui/components/button/index.js'
import PhotosGallery from './PhotosGallery.astro'
import { formatRelativeDate } from '../lib/post-date-format'
import { getMentionUrl, getResponseValue } from '../lib/post-mentions'
import { getChildren } from '../lib/post-children'
import { getPhotoUrl } from '../lib/post-media'

export interface Props {
  post: any
  compact?: boolean
}

const { post, compact = true } = Astro.props

if (!post) return

const postType = post?.postType ?? null
const properties = post?.properties ?? {}
const name = post.name ?? null
const content = properties.content?.[0] ?? null
const summary = properties.summary?.[0] ?? null
const published = properties.published?.[0] ?? null
const url = normalizeInternalUrl(post.url ?? properties.url?.[0])
const photo = properties.photo?.[0] ?? null
const category = post.categories ?? []

// Mention properties
// MF2 allows these to be strings (plain URL) or objects (embedded h-cite/h-entry).
// Normalise to just the URL string for rendering.
const siteUrl = getSiteUrl()
const likeOf = getMentionUrl(getResponseValue(properties['like-of'], siteUrl))
const repostOf = getMentionUrl(getResponseValue(properties['repost-of'], siteUrl))
const inReplyTo = getMentionUrl(getResponseValue(properties['in-reply-to'], siteUrl))
const bookmarkOf = getMentionUrl(properties['bookmark-of']?.[0])
const rsvp = properties.rsvp?.[0] ?? null

// Get action label (card-specific logic for compact rendering)
function getActionLabel(): string {
  if (postType === 'like' || likeOf) return 'Liked'
  if (postType === 'repost' || repostOf) return 'Reposted'
  if (postType === 'reply' || inReplyTo) return rsvp ? 'RSVPed' : 'Replied'
  if (postType === 'bookmark' || bookmarkOf) return 'Bookmarked'
  return ''
}

const actionLabel = getActionLabel()
const isCompactArticle = compact && postType === 'article' && Boolean(url)
const previewContent = isCompactArticle ? summary : content ?? summary
const children = await getChildren(post)

// Format date using shared helper
const dateDisplay = published ? formatRelativeDate(published) : ''

const authorName = site.author.name
---

<article class={`post post--${postType ?? 'unknown'} h-entry`}>
  <grantcodes-card>

    <!-- Post title -->
    {name && (
      <header class="post__header">
        <h1 class="post__title p-name">{name}</h1>
      </header>
    )}

    <!-- Action label (Liked, Reposted, etc.) -->
    {actionLabel && !name && (
      <p class="post__action" style="font-weight: bold;">
        {actionLabel}
      </p>
    )}

    <!-- Mention actions -->
    {likeOf && (
      <p class="post__action">
        <grantcodes-icon style="font-size: 12px" set:html={Heart}></grantcodes-icon>
        <a class="u-like-of" href={likeOf}>{likeOf.replace(/^https?:\/\//, '').slice(0, 60)}</a>
      </p>
    )}
    {repostOf && (
      <p class="post__action">
        <grantcodes-icon style="font-size: 12px" set:html={Repeat2}></grantcodes-icon>
        <a class="u-repost-of" href={repostOf}>{repostOf.replace(/^https?:\/\//, '').slice(0, 60)}</a>
      </p>
    )}
    {inReplyTo && (
      <p class="post__action">
        <grantcodes-icon style="font-size: 12px" set:html={Reply}></grantcodes-icon>
        {rsvp ? <>RSVPed <span class="p-rsvp">{rsvp}</span> to </> : 'Replied to '}
        <a class="u-in-reply-to" href={inReplyTo}>{inReplyTo.replace(/^https?:\/\//, '').slice(0, 60)}</a>
      </p>
    )}
    {bookmarkOf && (
      <p class="post__action">
        <grantcodes-icon style="font-size: 12px" set:html={Bookmark}></grantcodes-icon>
        <a class="u-bookmark-of" href={bookmarkOf}>{bookmarkOf.replace(/^https?:\/\//, '').slice(0, 60)}</a>
      </p>
    )}

    <!-- Photo -->
    {photo && (
      <div>
        {url ? (
          <a href={url}>
            <img src={getPhotoUrl(photo)} alt="" class="u-photo" loading="lazy" />
          </a>
        ) : (
          <img src={getPhotoUrl(photo)} alt="" class="u-photo" loading="lazy" />
        )}
      </div>
    )}

    {postType === 'collection' && children.length > 0 && (
      <PhotosGallery posts={children} type="collection" />
    )}

    <!-- Compact article cards show only their summary. -->
    {previewContent && <PostContent content={previewContent} />}

    <!-- For articles in compact: read more button -->
    {isCompactArticle && content && (
      <div class="post__read-more">
        {/* Spread works around grantcodes/ui#231 (global `variant` typing). */}
        <GrantCodesButton href={url} {...{ variant: 'outline' } as object}>Read full post</GrantCodesButton>
      </div>
    )}

    <!-- Footer: permalink + categories -->
    <footer class="post__footer">
      {(actionLabel ? `${actionLabel} ` : 'Posted ')}

      {url ? (
        <a href={url} class="u-url">
          {published ? <time class="dt-published" datetime={published}>{dateDisplay}</time> : 'Permalink'}
        </a>
      ) : (
        published && <time class="dt-published" datetime={published}>{dateDisplay}</time>
      )}

      {' ● '}
      <span class="p-author h-card">
        <span class="p-name">{authorName}</span>
      </span>

      {category.length > 0 && (
        <>
          {' ● Categories: '}
          {category.map((cat: any) => {
            const catName = typeof cat === 'object' ? cat.value ?? cat : cat
            if (typeof catName !== 'string') return null
            return <><a href={`/category/${encodeURIComponent(catName)}`} class="p-category">#{catName}</a>{' '}</>
          })}
        </>
      )}
    </footer>

    <!-- Hidden author h-card for MF2 crawlability -->
    <span class="p-author h-card screen-reader-text">
      <span class="p-name">{authorName}</span>
    </span>
  </grantcodes-card>
</article>

<style is:global>
  .post__action {
    margin: 0;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-size: 0.714rem;
  }
  .post__action grantcodes-icon {
    vertical-align: middle;
    margin-right: 0.3em;
  }

  .post__footer {
    opacity: 0.7;
  }
  .post__footer,
  .post__footer * {
    line-height: 1.2;
    font-size: 0.51rem;
  }
  .post__footer .h-card {
    display: inline-block;
    text-decoration: none;
    font-size: 0.5em;
    margin-top: -0.25em;
  }
  .post__footer .h-card .p-name {
    text-decoration: underline;
  }
  .post__footer .h-card .p-name:hover {
    text-decoration: underline wavy;
  }

  .post__content > p:first-child {
    margin-top: 0;
  }
</style>
