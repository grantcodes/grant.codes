---
// Opens `a[data-post-modal]` links (a post's permalink) in a dialog over the current page,
// like a Next.js intercepted route: the URL changes, Back closes it, and a reload, direct
// visit or browser without JS gets the normal post page.
import { X } from 'lucide-static'
---

<dialog class="post-modal" closedby="any" aria-label="Post">
  <div class="post-modal__body"></div>
  <form method="dialog">
    <button class="post-modal__close" aria-label="Close">
      <grantcodes-icon set:html={X}></grantcodes-icon>
    </button>
  </form>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('dialog.post-modal')
  const body = dialog?.querySelector<HTMLElement>('.post-modal__body')
  // Needed to keep the server-rendered (declarative) shadow DOM of the fetched custom elements.
  const canParse = 'parseHTMLUnsafe' in Document

  if (dialog && body && canParse) {
    const pageTitle = document.title
    let controller: AbortController | undefined

    // Adds the fetched page's styles that this page doesn't have yet.
    const adoptStyles = (doc: Document) => {
      const have = new Set(
        [...document.head.querySelectorAll('link[rel="stylesheet"], style')].map(
          (el) => el.getAttribute('href') ?? el.getAttribute('data-vite-dev-id') ?? el.textContent
        )
      )
      for (const el of doc.head.querySelectorAll('link[rel="stylesheet"], style')) {
        const key = el.getAttribute('href') ?? el.getAttribute('data-vite-dev-id') ?? el.textContent
        if (!have.has(key)) document.head.append(el.cloneNode(true))
      }
    }

    // Resolves once an image has loaded (or after `ms`), so the dialog opens at its final size.
    // A failed load isn't final: the img's onerror may swap in a fallback src.
    const loaded = (img: HTMLImageElement, ms: number) =>
      img.complete && img.naturalWidth
        ? Promise.resolve()
        : new Promise<void>((resolve) => {
            img.addEventListener('load', () => resolve(), { once: true })
            setTimeout(resolve, ms)
          })

    const open = async (url: string) => {
      controller?.abort()
      controller = new AbortController()
      document.documentElement.style.cursor = 'progress'
      try {
        const res = await fetch(url, { signal: controller.signal })
        if (!res.ok) throw new Error(String(res.status))
        const doc = (Document as any).parseHTMLUnsafe(await res.text()) as Document
        const post = doc.querySelector('main grantcodes-card')
        if (!post) throw new Error('no post')
        adoptStyles(doc)
        const images = [...post.querySelectorAll('img')]
        for (const img of images) img.loading = 'eager'
        body.replaceChildren(document.adoptNode(post))
        await Promise.all(images.map((img) => loaded(img, 2000)))
        if (controller.signal.aborted) return
        document.title = doc.title
        if (!dialog.open) dialog.showModal()
        body.scrollTop = 0
      } catch (err) {
        if ((err as Error).name !== 'AbortError') location.href = url
      } finally {
        document.documentElement.style.cursor = ''
      }
    }

    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Element)) return
      const link = event.target.closest<HTMLAnchorElement>('a[data-post-modal]')
      if (!link || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return
      event.preventDefault()
      history.pushState({ postModal: link.href }, '', link.href)
      open(link.href)
    })

    // Closing (Escape, ×, backdrop) returns to the page's own URL.
    dialog.addEventListener('close', () => {
      controller?.abort()
      document.title = pageTitle
      // Clear after the exit transition (and stop any embedded video).
      setTimeout(() => dialog.open || body.replaceChildren(), 300)
      if (history.state?.postModal) history.back()
    })

    window.addEventListener('popstate', (event) => {
      if (event.state?.postModal) open(event.state.postModal)
      else if (dialog.open) dialog.close()
    })

    // Light dismiss for browsers without `closedby` (Safari).
    if (!('closedBy' in HTMLDialogElement.prototype)) {
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close()
      })
    }
  }
</script>

<style is:global>
  .post-modal {
    inline-size: min(var(--width-article), calc(100vw - 2rem));
    max-block-size: calc(100dvh - 6rem);
    padding: 0;
    border: none;
    background: transparent;
    overflow: visible;
  }
  .post-modal:modal {
    overscroll-behavior: contain;
  }
  .post-modal::backdrop {
    overflow: hidden;
    overscroll-behavior: contain;
  }
  .post-modal__body {
    max-block-size: calc(100dvh - 6rem);
    overflow: auto;
    overscroll-behavior: contain;
  }
  /* Above the dialog's corner: the dialog's scale animation makes it the containing block. */
  .post-modal__close {
    position: absolute;
    inset-block-end: 100%;
    inset-inline-end: 0;
    padding: 0.25rem;
    border: none;
    background: none;
    color: white;
    font-size: 1.5rem;
    cursor: pointer;
  }
</style>
