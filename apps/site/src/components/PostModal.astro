---
// Opens `a[data-post-modal]` links (a post's permalink) in a grantcodes-dialog over the current
// page, like a Next.js intercepted route: the URL changes, Back closes it, and a reload, direct
// visit or browser without JS gets the normal post page.
import { GrantCodesDialog } from '@grantcodes/ui/components/dialog/index.js'
---

{/* Client-only: server-rendered, grantcodes-dialog 4.1.2 hydrates without its header and dismiss button. */}
<GrantCodesDialog client:only="@grantcodes/astro" class="post-modal" aria-label="Post">
  <h2 slot="header" class="post-modal__title"></h2>
  <div class="post-modal__body"></div>
</GrantCodesDialog>

<script>
  type Dialog = HTMLElement & { open: boolean }
  // The dialog is client-only, so it may not exist yet when this runs; look it up on use.
  const modal = () => document.querySelector<Dialog>('grantcodes-dialog.post-modal')
  const part = (selector: string) => modal()?.querySelector<HTMLElement>(selector)
  // Needed to keep the server-rendered (declarative) shadow DOM of the fetched custom elements.
  const canParse = 'parseHTMLUnsafe' in Document

  if (canParse) {
    const pageTitle = document.title
    let controller: AbortController | undefined

    // Adds the fetched page's styles that this page doesn't have yet.
    const adoptStyles = (doc: Document) => {
      const have = new Set(
        [...document.head.querySelectorAll('link[rel="stylesheet"], style')].map(
          (el) => el.getAttribute('href') ?? el.getAttribute('data-vite-dev-id') ?? el.textContent
        )
      )
      for (const el of doc.head.querySelectorAll('link[rel="stylesheet"], style')) {
        const key = el.getAttribute('href') ?? el.getAttribute('data-vite-dev-id') ?? el.textContent
        if (!have.has(key)) document.head.append(el.cloneNode(true))
      }
    }

    // Resolves once an image has loaded (or after `ms`), so the dialog opens at its final size.
    // A failed load isn't final: the img's onerror may swap in a fallback src.
    const loaded = (img: HTMLImageElement, ms: number) =>
      img.complete && img.naturalWidth
        ? Promise.resolve()
        : new Promise<void>((resolve) => {
            img.addEventListener('load', () => resolve(), { once: true })
            setTimeout(resolve, ms)
          })

    const open = async (url: string) => {
      const dialog = modal()
      const title = part('.post-modal__title')
      const body = part('.post-modal__body')
      if (!dialog || !title || !body) return void (location.href = url)
      controller?.abort()
      controller = new AbortController()
      document.documentElement.style.cursor = 'progress'
      try {
        const res = await fetch(url, { signal: controller.signal })
        if (!res.ok) throw new Error(String(res.status))
        const doc = (Document as any).parseHTMLUnsafe(await res.text()) as Document
        const post = doc.querySelector('main article.post')
        if (!post) throw new Error('no post')
        adoptStyles(doc)
        // The post's name becomes the dialog header; unnamed posts show their date instead.
        // (A featured-image header stays in the body: it carries the image.)
        const name = post.querySelector('.post__header:not(.post__header--featured)')
        title.textContent =
          name?.textContent?.trim() || post.querySelector('.dt-published')?.textContent?.trim() || 'Post'
        name?.remove()
        const images = [...post.querySelectorAll('img')]
        for (const img of images) img.loading = 'eager'
        body.replaceChildren(document.adoptNode(post))
        // Images with width/height already reserve their space; only wait for the others.
        await Promise.all(images.filter((img) => !img.getAttribute('width')).map((img) => loaded(img, 2000)))
        if (controller.signal.aborted) return
        document.title = doc.title
        await customElements.whenDefined('grantcodes-dialog')
        dialog.open = true
      } catch (err) {
        if ((err as Error).name !== 'AbortError') location.href = url
      } finally {
        document.documentElement.style.cursor = ''
      }
    }

    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Element)) return
      const link = event.target.closest<HTMLAnchorElement>('a[data-post-modal]')
      if (!link || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return
      event.preventDefault()
      history.pushState({ postModal: link.href }, '', link.href)
      open(link.href)
    })

    // Closing (Escape, ×, backdrop) returns to the page's own URL.
    document.addEventListener('toggle', (event) => {
      const dialog = modal()
      if (event.target !== dialog || !(event instanceof CustomEvent) || event.detail.open) return
      controller?.abort()
      document.title = pageTitle
      // Clear after the exit transition (and stop any embedded video).
      setTimeout(() => dialog?.open || part('.post-modal__body')?.replaceChildren(), 300)
      if (history.state?.postModal) history.back()
    })

    window.addEventListener('popstate', (event) => {
      const dialog = modal()
      if (event.state?.postModal) open(event.state.postModal)
      else if (dialog?.open) dialog.open = false
    })
  }
</script>

<style is:global>
  .post-modal {
    --g-dialog-inline-size: var(--width-article);
  }
  .post-modal__title {
    margin: 0;
    /* Clear the dialog's dismiss button in the top-right corner. */
    padding-inline-end: 2.5rem;
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    line-height: 1.2;
  }
</style>
