---
// Site footer — social links + h-card
// Ported from apps/web/components/Container/Footer/index.js

const authorEmail = import.meta.env.NEXT_PUBLIC_AUTHOR_EMAIL ?? ''
const instagram = import.meta.env.NEXT_PUBLIC_AUTHOR_INSTAGRAM ?? ''
const github = import.meta.env.NEXT_PUBLIC_AUTHOR_GITHUB ?? ''
const authorName = import.meta.env.NEXT_PUBLIC_AUTHOR_NAME ?? ''
const url = import.meta.env.NEXT_PUBLIC_URL ?? ''
const siteName = import.meta.env.NEXT_PUBLIC_SITE_NAME ?? ''
const description = import.meta.env.NEXT_PUBLIC_META_DESCRIPTION ?? ''
const authorPhoto = import.meta.env.NEXT_PUBLIC_AUTHOR_PHOTO ?? ''
const authorFeatured = import.meta.env.NEXT_PUBLIC_AUTHOR_FEATURED ?? ''
---

<footer class="main-footer">
  <div>
    <a class="main-footer__icon" href={`mailto:${authorEmail}`} rel="me" aria-label="Email">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="2" y="4" width="20" height="16" rx="2" />
        <path d="M22 4L12 13L2 4" />
      </svg>
      <span class="screen-reader-text">Email</span>
    </a>
    {instagram && (
      <a class="main-footer__icon" href={instagram} rel="me" aria-label="Instagram">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="2" y="2" width="20" height="20" rx="5" />
          <circle cx="12" cy="12" r="5" />
          <circle cx="17.5" cy="6.5" r="1.5" />
        </svg>
        <span class="screen-reader-text">Instagram</span>
      </a>
    )}
    {github && (
      <a class="main-footer__icon" href={github} rel="me" aria-label="GitHub">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.167 6.839 9.49.5.09.682-.217.682-.482 0-.237-.009-.866-.013-1.7-2.782.604-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.115 2.504.337 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.577.688.48C19.138 20.163 22 16.418 22 12c0-5.523-4.477-10-10-10z" />
        </svg>
        <span class="screen-reader-text">Github</span>
      </a>
    )}
  </div>

  <!-- Hidden h-card for IndieWeb -->
  <p class="h-card screen-reader-text">
    <span class="p-name">{authorName}</span>
    <br />
    <a href={url} class="u-url" rel="me">{siteName}</a>
    <a class="p-email" href={`mailto:${authorEmail}`}>{authorEmail}</a>
    {description && <data class="p-note" value={description} />}
    <data class="u-photo" value={authorPhoto} />
    {authorFeatured && <data class="u-featured" value={authorFeatured} />}
  </p>

</footer>
