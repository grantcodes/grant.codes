---
// Site footer — social links + hidden h-card
// Uses SSR GrantCodesFooter for layout and styling.

import { GrantCodesFooter, GrantCodesFooterColumn } from '@grantcodes/ui/components/footer/index.js'
import { Mail, Instagram, Github } from 'lucide-static'

const authorEmail = import.meta.env.NEXT_PUBLIC_AUTHOR_EMAIL ?? ''
const instagram = import.meta.env.NEXT_PUBLIC_AUTHOR_INSTAGRAM ?? ''
const github = import.meta.env.NEXT_PUBLIC_AUTHOR_GITHUB ?? ''
const authorName = import.meta.env.NEXT_PUBLIC_AUTHOR_NAME ?? ''
const url = import.meta.env.NEXT_PUBLIC_URL ?? ''
const siteName = import.meta.env.NEXT_PUBLIC_SITE_NAME ?? ''
const description = import.meta.env.NEXT_PUBLIC_META_DESCRIPTION ?? ''
const authorPhoto = import.meta.env.NEXT_PUBLIC_AUTHOR_PHOTO ?? ''
const authorFeatured = import.meta.env.NEXT_PUBLIC_AUTHOR_FEATURED ?? ''
---

<div class="main-footer">
  <GrantCodesFooter columns={1}>
    <GrantCodesFooterColumn>
      <div class="social-links">
        <a href={`mailto:${authorEmail}`} rel="me" aria-label="Email">
          <grantcodes-icon style="font-size: 24px" set:html={Mail}></grantcodes-icon>
        </a>
        {instagram && (
          <a href={instagram} rel="me" aria-label="Instagram">
            <grantcodes-icon style="font-size: 24px" set:html={Instagram}></grantcodes-icon>
          </a>
        )}
        {github && (
          <a href={github} rel="me" aria-label="GitHub">
            <grantcodes-icon style="font-size: 24px" set:html={Github}></grantcodes-icon>
          </a>
        )}
      </div>
    </GrantCodesFooterColumn>
    <!-- Hidden h-card for IndieWeb identity, placed in the bottom slot -->
    <div slot="bottom" class="h-card screen-reader-text">
      <span class="p-name">{authorName}</span>
      <br />
      <a href={url} class="u-url" rel="me">{siteName}</a>
      <a class="p-email" href={`mailto:${authorEmail}`}>{authorEmail}</a>
      {description && <data class="p-note" value={description} />}
      <data class="u-photo" value={authorPhoto} />
      {authorFeatured && <data class="u-featured" value={authorFeatured} />}
    </div>
  </GrantCodesFooter>
</div>
