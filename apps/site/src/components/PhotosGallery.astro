---
// Square photo grid.
// - type "feed": each photo links to its post; hidden h-entries keep the feed parseable.
// - type "collection": photos of a collection's children open in the lightbox.

import { site } from '../lib/site'
import { normalizeInternalUrl } from '../lib/url'
import { getThumbnailUrl } from '../lib/post-media'
import { GrantCodesGallery } from '@grantcodes/ui/components/gallery/index.js'

export interface Props {
  posts: any[]
  type?: 'feed' | 'collection'
}

const { posts = [], type = 'feed' } = Astro.props

const photos = posts.flatMap((post) =>
  (post.photos ?? []).map((photo: { url: string; alt?: string }) => ({
    permalink: normalizeInternalUrl(post.url),
    url: photo.url,
    alt: photo.alt || post.name || '',
    thumbnail: getThumbnailUrl(photo.url),
  }))
)
// A missing thumbnail falls back to the full photo; a missing photo hides its tile.
const onThumbnailError =
  "if (this.src !== this.dataset.full) { this.src = this.dataset.full } else { this.onerror = null; this.closest('a').hidden = true }"
---

{photos.length > 0 && (
  <GrantCodesGallery class="photos-gallery">
    {photos.map((photo) =>
      type === 'feed' ? (
        <a href={photo.permalink} class="photos-gallery__item">
          <img src={photo.thumbnail} data-full={photo.url} onerror={onThumbnailError} alt={photo.alt} loading="lazy" />
        </a>
      ) : (
        <a
          href={photo.url}
          class="photos-gallery__item h-cite"
          data-zoom
          data-permalink={photo.permalink}
        >
          <img src={photo.thumbnail} data-full={photo.url} onerror={onThumbnailError} alt={photo.alt} class="u-photo" loading="lazy" />
          <data class="u-url" value={photo.permalink} />
        </a>
      )
    )}
  </GrantCodesGallery>
)}

{type === 'feed' && posts.length > 0 && (
  <div class="screen-reader-text">
    {posts.map((post) => (
      <article class="h-entry">
        <a class="u-url" href={normalizeInternalUrl(post.url)}>{post.url}</a>
        <time class="dt-published" datetime={post.published.toISOString()}>{post.published.toISOString()}</time>
        {post.photos.map((photo: { url: string }) => <data class="u-photo" value={photo.url} />)}
        {post.content && <div class="e-content" set:html={post.content.html} />}
        <span class="p-author h-card"><span class="p-name">{site.author.name}</span></span>
      </article>
    ))}
  </div>
)}

<style is:global>
  .photos-gallery {
    display: block;
    --gallery-columns: 5;
    --gallery-gap: 0.25rem;
  }
  @media (max-width: 30rem) {
    .photos-gallery {
      --gallery-columns: 3;
    }
  }
  .photos-gallery__item {
    display: block;
    min-inline-size: 0;
    overflow: hidden;
    border-radius: 0.25rem;
  }
  .photos-gallery__item[hidden] {
    display: none;
  }
  .photos-gallery__item img {
    display: block;
    inline-size: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  .photos-gallery__item:hover img,
  .photos-gallery__item:focus-visible img {
    transform: scale(1.05);
  }
  @media (prefers-reduced-motion: reduce) {
    .photos-gallery__item img {
      transition: none;
    }
  }
</style>
