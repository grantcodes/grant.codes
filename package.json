{
  "name": "grant.codes",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@11.15.0",
  "engines": {
    "node": "24.x"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/api --filter ./apps/site dev",
    "dev:api": "pnpm --filter api dev",
    "dev:site": "pnpm --filter ./apps/site dev",
    "build": "pnpm --filter ./apps/site build && pnpm --filter api build",
    "build:api": "pnpm --filter api build",
    "build:site": "pnpm --filter ./apps/site build",
    "start": "if [ -f \"${POSTR_DATABASE:-apps/api/.data/postr.db}\" ]; then pnpm run build:site; else echo \"No postr database yet: skipping the site build. Import one with apps/api/scripts/import-legacy.mjs, then restart.\"; fi && pnpm run start:api",
    "start:api": "pnpm --filter api start",
    "test": "pnpm --filter api test"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "trailingComma": "es5"
  }
}
