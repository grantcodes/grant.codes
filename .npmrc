# Allow build scripts for native modules used by apps
onlyBuiltDependencies[]=canvas
onlyBuiltDependencies[]=sharp
onlyBuiltDependencies[]=esbuild
onlyBuiltDependencies[]=leveldown
onlyBuiltDependencies[]=core-js
onlyBuiltDependencies[]=@parcel/watcher
onlyBuiltDependencies[]=rxdb
onlyBuiltDependencies[]=unrs-resolver

# Hoist lucide-static so @grantcodes/ui icons resolve correctly
public-hoist-pattern[]=lucide-static
